# Copy to .env and fill in. Never commit .env. Variables use the OMS_ prefix.

# Runtime mode: mock (offline, no keys, synthetic media) or live (real LLM/TTS/YouTube).
OMS_MODE=mock

# --- FREE-TIER SETUP (recommended) ------------------------------------------------------------
# Google AI Studio key created in a Google Cloud project WITHOUT Cloud Billing linked.
# Free tier covers Gemini text/vision (research, script, storyboard, metadata, reports),
# Google Search grounding (5,000 queries/month on Gemini 3.x) and Gemini TTS.
# WARNING: a key from a project WITH billing is charged at list price and the $300 trial
# credit does NOT cover the Gemini API in AI Studio.
OMS_GOOGLE_API_KEY=

# Visuals are generated by you in Google Flow with your Google AI subscription credits
# (generation.mode: manual in config/default.yaml). No Veo API call is ever made in manual mode.
# Only switch to generation.mode: veo deliberately; Veo 3.1 Lite has no free tier ($0.05-0.08/s).

# --- Optional -------------------------------------------------------------------------------------
# Anthropic key if llm.provider is set to "anthropic" in config/local.yaml.
OMS_ANTHROPIC_API_KEY=

# YouTube OAuth Desktop-app client JSON (YouTube Data API v3 + YouTube Analytics API enabled).
# These APIs are free within quota. Run `python -m app.cli youtube-auth` once after placing it.
OMS_YOUTUBE_CLIENT_SECRET_PATH=secrets/youtube_client_secret.json
OMS_YOUTUBE_TOKEN_PATH=secrets/youtube_token.json

# Any config/default.yaml value can be overridden with OMS_<SECTION>__<KEY>, e.g.:
# OMS_UPLOAD__ENABLED=true
# OMS_UPLOAD__VISIBILITY=public
# OMS_TTS__PROVIDER=edge
# OMS_LIMITS__MAX_VIDEOS_PER_DAY=1
