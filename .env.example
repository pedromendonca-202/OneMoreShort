# Copy to .env and fill in. Never commit .env.

# Google AI Studio key WITH Cloud Billing enabled (Veo has no free tier).
# Drives Gemini text/vision, Google Search grounding, Gemini TTS and Veo 3.1 Lite.
GOOGLE_API_KEY=

# Optional: Anthropic key if llm.provider is set to "anthropic".
ANTHROPIC_API_KEY=

# Optional: separate key for YouTube Data API read-only calls (trending). Falls back to GOOGLE_API_KEY.
YOUTUBE_API_KEY=

# OAuth installed-app client JSON downloaded from Google Cloud Console (YouTube Data API v3 +
# YouTube Analytics API enabled). Default location: secrets/client_secret.json
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json

# Runtime mode: mock (offline, no keys needed) or live.
OMS_MODE=mock

# Any settings.yaml value can be overridden with OMS_<SECTION>__<KEY>, e.g.:
# OMS_LIMITS__DAILY_BUDGET_USD=10
# OMS_UPLOAD__ENABLED=false
# OMS_VEO__RESOLUTION=720p
